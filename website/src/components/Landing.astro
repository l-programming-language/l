---
import source from '../../../demo/basic/main.l?raw';
import version from '../../.generated/version.json';
import { Code } from '@astrojs/starlight/components';
---
<div class="l-home">
  <section class="l-hero" aria-labelledby="home-heading">
    <div class="l-hero-copy">
      <p class="l-eyebrow">The L programming language</p>
      <h1 id="home-heading">Readable source.<br /><span>Applications<br class="l-break" /> as values.</span></h1>
      <p id="pipeline-heading" class="l-intro">Write programs in sentences and coordinate Apps as separate processes. <span id="rust-pipeline-caption">L generates Rust and builds native programs you can run.</span></p>
      <div id="start-heading" class="l-actions"><a id="build-heading" class="l-primary" href="/docs/cli/installation/">Install L <span aria-hidden="true">→</span></a><a class="l-secondary" href="/docs/guide/first-program/">Build your first program</a></div>
      <p class="l-reference-links"><a href="/docs/guide/">Learn L</a><a href="/docs/spec/">Language reference</a></p>
      <p class="l-status"><span class="l-status-channel"><span class="l-dot" aria-hidden="true"></span> {version.languageVersion ?? 'Unreleased'} / {version.channel === 'production' ? 'Release' : 'Local'}</span><span>English source</span><span>macOS &amp; Linux</span></p>
    </div>
    <div class="l-example">
      <div class="l-example-label"><span>Hello World</span><a href="/docs/guide/first-program/">Read the walkthrough →</a></div>
      <Code code={source} lang="l" title="Hello World" />
      <div class="l-output"><span>Expected output</span><pre>Hello World!{ '\n' }</pre></div>
    </div>
  </section>
</div>
