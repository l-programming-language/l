---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import version from '../../.generated/version.json';
---
{Astro.url.pathname !== '/' && <DefaultFooter />}
<div class="l-provenance" data-pagefind-ignore>
  <a href="/releases/">{version.languageVersion ?? 'Unreleased'} / {version.channel === 'production' ? 'Release' : 'Local'}</a>
  <a href="/docs/">Browse all documentation</a>
  <a href="/version.json">Build identity</a>
  <p>Source-backed documentation. Language execution has not been verified by this website build.</p>
</div>
