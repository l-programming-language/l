// Start Execute Glyph
// Schedule the supplied future.
// Execute adds no function, invocation, async wrapper, or task group.
{|/|-{tags: Meta.Tags}--{if Type == "Default"}--{
tokio::spawn([|Meta.Key|]);
}-|/|}

// Exactly one Instantiation child whose output role is an invocation.
{|/|-{tags: Meta.Tags}--{if Type == "Instantiation"}--{
tokio::spawn([|Conjoinments.Instantiation|]);
}-|/|}
// End Execute Glyph

