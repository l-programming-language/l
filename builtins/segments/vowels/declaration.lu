// package [|Meta.Package|]


(/={tags: ["Initialization"]}=={for Header in Headers}=={use |Header|;
}=/)

}-|/|}

{|/|-{tags: Meta.Tags}--{if Type == "E"}--{
[|Meta.Contents|]
}-|/|}

{|/|-{tags: Meta.Tags}--{if Type == "Declare"}--{
