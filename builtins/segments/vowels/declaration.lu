}-|/|}

{|/|-{tags: Meta.Tags}--{if Type == "Calculate"}--{
[|Declare("Calculation", Calculation = Conjoinments.Calculation)|]
}-|/|}

{|/|-{tags: Meta.Tags}--{if Type == "Operate"}--{
[|Declare("Operation", Operation = Conjoinments.Operation)|]
}-|/|}

{|/|-{tags: Meta.Tags}--{if Type == "Describe"}--{
[|Declare("Description", Description = Conjoinments.Description)|]
}-|/|}

{|/|-{tags: Meta.Tags}--{if Type == "Evaluate"}--{
[|Declare("Evaluation", Evaluation = Conjoinments.Evaluation)|]
}-|/|}

{|/|-{tags: Meta.Tags}--{if Type == "Instantiate"}--{
[|Declare("Instantiation", Instantiation = Conjoinments.Instantiation)|]
}-|/|}

{|/|-{tags: Meta.Tags}--{if Type == "Iterate"}--{
[|Declare("Iteration", Iteration = Conjoinments.Iteration)|]
}-|/|}

